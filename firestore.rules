rules_version = '2';

// All reads and writes go through our Next.js API, which uses the Admin SDK.
// The Admin SDK bypasses these rules, so the rules can (and should) deny every
// direct client access. A leaked web API key therefore cannot read or write data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
