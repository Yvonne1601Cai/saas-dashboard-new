# Copy to .env.local. The defaults below target the local Firebase emulators and
# work with no Firebase project and no secrets ("demo-" project ids can never
# reach real Google Cloud resources).

# --- Firebase web config (public by design; it identifies the project, it is not a secret) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-saas-dashboard.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-saas-dashboard
# Emulator only: stops Google's auth library probing for a cloud metadata server (noisy warning).
METADATA_SERVER_DETECTION=none
# "true" connects the browser SDK to the Auth emulator. Must be "false" in production.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# --- Firebase Admin (server only) ---
# With these two set, firebase-admin talks to the emulators and needs no credentials.
# Remove both in production and provide FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY
# (or Application Default Credentials) instead.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-saas-dashboard
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- AI description generation (optional) ---
# Leave empty to use the deterministic mock provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
